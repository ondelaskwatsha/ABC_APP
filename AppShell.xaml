<?xml version="1.0" encoding="UTF-8" ?>
<!--
  AppShell.xaml  -  the bottom TAB BAR of the app.

  A Shell is the "frame" around all pages. Here it shows 5 tabs at the bottom.
  Each ShellContent is one tab:
    Title           = the text under the icon
    Icon            = the picture (files in Resources/Images, .svg is turned into .png automatically)
    Route           = the tab's name, used to jump to it from code, for example GoToAsync("//Contact")
    ContentTemplate = which page to show

  The Shell.* settings below set the tab bar colours (light blue when selected, grey when not).
  NavBarIsVisible="False" hides the title bar at the top, because our pages have their own big titles.
-->
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:AndiswaConsultationApp.Pages"
       x:Class="AndiswaConsultationApp.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       Shell.BackgroundColor="White"
       Shell.TabBarBackgroundColor="White"
       Shell.TabBarForegroundColor="#1F7AC2"
       Shell.TabBarTitleColor="#1F7AC2"
       Shell.TabBarUnselectedColor="#7C97AB">

    <!-- Home and Contact are finished.
         About, Services and Portfolio are empty pages for teammates to build. -->
    <TabBar>
        <ShellContent Title="Home" Icon="tab_home.png" Route="Home"
                      ContentTemplate="{DataTemplate pages:HomePage}" />
        <ShellContent Title="About" Icon="tab_about.png" Route="About"
                      ContentTemplate="{DataTemplate pages:AboutPage}" />
        <ShellContent Title="Services" Icon="tab_services.png" Route="Services"
                      ContentTemplate="{DataTemplate pages:ServicesPage}" />
        <ShellContent Title="Portfolio" Icon="tab_portfolio.png" Route="Portfolio"
                      ContentTemplate="{DataTemplate pages:PortfolioPage}" />
        <ShellContent Title="Contact" Icon="tab_contact.png" Route="Contact"
                      ContentTemplate="{DataTemplate pages:ContactPage}" />
    </TabBar>
</Shell>
