<?xml version="1.0" encoding="UTF-8" ?>
<!--
  AppShell.xaml  -  the NAVIGATION of the app: the tabs (Home, Services, Portfolio, Contact, More)
  plus the two Account pages (client login and client dashboard).
  Pages opened on top (About, Team, Testimonials, Settings, project detail) are registered in AppShell.xaml.cs.
  The Shell.* colours use {DynamicResource ...} so they follow dark / light mode.

  Shell.TabBarIsVisible="False": the built-in tab bar is HIDDEN, because on Windows it sits at the top.
  Instead every tab page shows our own bar at the bottom (Controls/BottomNavBar.cs, added by the
  "TabPage" template in App.xaml). The tabs below still exist so "//Home", "//Contact" ... keep working.
-->
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:AndiswaConsultationApp.Pages"
       x:Class="AndiswaConsultationApp.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       Shell.BackgroundColor="{DynamicResource Surface}"
       Shell.ForegroundColor="{DynamicResource Navy}"
       Shell.TitleColor="{DynamicResource Navy}"
       Shell.TabBarBackgroundColor="{DynamicResource Surface}"
       Shell.TabBarForegroundColor="{DynamicResource Navy}"
       Shell.TabBarTitleColor="{DynamicResource Navy}"
       Shell.TabBarUnselectedColor="{DynamicResource Soft}"
       Shell.TabBarIsVisible="False">

    <TabBar>
        <ShellContent Title="Home" Icon="tab_home.png" Route="Home"
                      ContentTemplate="{DataTemplate pages:HomePage}" />
        <ShellContent Title="Services" Icon="tab_services.png" Route="Services"
                      ContentTemplate="{DataTemplate pages:ServicesPage}" />
        <ShellContent Title="Portfolio" Icon="tab_portfolio.png" Route="Portfolio"
                      ContentTemplate="{DataTemplate pages:PortfolioPage}" />
        <ShellContent Title="Contact" Icon="tab_contact.png" Route="Contact"
                      ContentTemplate="{DataTemplate pages:ContactPage}" />
        <ShellContent Title="More" Icon="tab_more.png" Route="More"
                      ContentTemplate="{DataTemplate pages:MorePage}" />

        <!-- The "Account" button of the bottom bar opens one of these two -->
        <ShellContent Title="Account" Route="ClientLogin"
                      ContentTemplate="{DataTemplate pages:ClientLoginPage}" />
        <ShellContent Title="My Dashboard" Route="ClientDashboard"
                      ContentTemplate="{DataTemplate pages:ClientDashboardPage}" />
    </TabBar>
</Shell>