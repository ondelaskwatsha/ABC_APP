<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AndiswaConsultationApp.Controls"
             x:Class="AndiswaConsultationApp.Pages.SettingsPage"
             Title="Settings"
             BackgroundColor="{DynamicResource PageBg}"
             Shell.NavBarIsVisible="True">

    <ScrollView>
        <VerticalStackLayout Padding="24,32,24,48" Spacing="16">

            <controls:SectionHeader Tag="SETTINGS" TitleMain="Make the app" TitleAccent="yours." />

            <!-- ===== 1. DARK MODE ===== -->
            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label Text="Dark mode" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource Navy}" />
                        <Label Text="Easier on the eyes at night" FontSize="13" TextColor="{DynamicResource Muted}" />
                    </VerticalStackLayout>
                    <Switch x:Name="DarkSwitch" Grid.Column="1" VerticalOptions="Center"
                            OnColor="{DynamicResource Steel}" Toggled="OnDarkToggled" />
                </Grid>
            </Border>

            <!-- ===== 2. FONT STYLE (rows are created in SettingsPage.xaml.cs) ===== -->
            <VerticalStackLayout Spacing="10" Margin="0,10,0,0">
                <Label Text="Font style" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource Navy}" />
                <Label Text="Tap a font to use it across the whole app." FontSize="13" TextColor="{DynamicResource Muted}" />
                <VerticalStackLayout x:Name="FontList" Spacing="10" Margin="0,6,0,0" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>