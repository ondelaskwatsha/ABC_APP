<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AndiswaConsultationApp.Controls"
             xmlns:models="clr-namespace:AndiswaConsultationApp.Models"
             x:Class="AndiswaConsultationApp.Pages.MorePage"
             BackgroundColor="{DynamicResource PageBg}"
             ControlTemplate="{StaticResource TabPage}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <VerticalStackLayout Padding="24,56,24,24" Spacing="18">
                <controls:SectionHeader Tag="MORE" TitleMain="Explore the" TitleAccent="Studio" />

                <!-- The studio logo on a black tile (the logo picture has a black background) -->
                <Border BackgroundColor="Black" StrokeThickness="0" StrokeShape="RoundRectangle 18" Margin="0,6,0,0">
                    <Image Source="ab_logo.jpg" Aspect="AspectFit" HeightRequest="170" />
                </Border>
            </VerticalStackLayout>

            <!-- One row for every link -->
            <VerticalStackLayout Padding="24,0,24,12" Spacing="12"
                                 BindableLayout.ItemsSource="{x:Static models:SiteContent.MoreLinks}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLinkTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="14">
                                <Border BackgroundColor="{DynamicResource Mist}" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 26" WidthRequest="52" HeightRequest="52">
                                    <Image Source="{Binding Icon}" WidthRequest="24" HeightRequest="24"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Title}" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource Navy}" />
                                    <Label Text="{Binding Subtitle}" FontSize="13" TextColor="{DynamicResource Muted}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="28" TextColor="{DynamicResource Soft}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- SETTINGS row (dark mode + font style) -->
            <VerticalStackLayout Padding="24,0,24,48">
                <Border Style="{StaticResource Card}" Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSettingsTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="14">
                        <Border BackgroundColor="{DynamicResource Mist}" StrokeThickness="0"
                                StrokeShape="RoundRectangle 26" WidthRequest="52" HeightRequest="52">
                            <Label Text="⚙️" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Settings" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource Navy}" />
                            <Label Text="Dark mode and font style" FontSize="13" TextColor="{DynamicResource Muted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="28" TextColor="{DynamicResource Soft}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <controls:SiteFooter />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>