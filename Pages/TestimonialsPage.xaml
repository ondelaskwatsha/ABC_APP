<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AndiswaConsultationApp.Controls"
             xmlns:models="clr-namespace:AndiswaConsultationApp.Models"
             x:Class="AndiswaConsultationApp.Pages.TestimonialsPage"
             Title="Testimonials"
             BackgroundColor="{DynamicResource PageBg}"
             Shell.NavBarIsVisible="True">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <VerticalStackLayout Padding="24,40,24,24" Spacing="14">
                <controls:SectionHeader Tag="CLIENT LOVE" TitleMain="What Our Clients Say" />
            </VerticalStackLayout>

            <!-- One card for every review -->
            <VerticalStackLayout Padding="24,0,24,48" Spacing="14"
                                 BindableLayout.ItemsSource="{x:Static models:SiteContent.Testimonials}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="22">
                            <VerticalStackLayout Spacing="14">
                                <Label Text="{Binding Stars}" FontSize="20" TextColor="{DynamicResource Steel}" />
                                <Label Text="{Binding Quote}" FontSize="16" LineHeight="1.5" FontAttributes="Italic"
                                       TextColor="{DynamicResource Ink}" />
                                <HorizontalStackLayout Spacing="14">
                                    <Border BackgroundColor="{Binding AvatarColor}" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 26" WidthRequest="52" HeightRequest="52">
                                        <Label Text="{Binding Initials}" FontSize="17" FontAttributes="Bold" TextColor="White"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout VerticalOptions="Center" Spacing="1">
                                        <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource Navy}" />
                                        <Label Text="{Binding Role}" FontSize="13" TextColor="{DynamicResource Muted}" />
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <controls:SiteFooter />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>