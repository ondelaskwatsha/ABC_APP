<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AndiswaConsultationApp.Controls"
             xmlns:models="clr-namespace:AndiswaConsultationApp.Models"
             x:Class="AndiswaConsultationApp.Pages.AboutPage"
             Title="About Us"
             BackgroundColor="{DynamicResource PageBg}"
             Shell.NavBarIsVisible="True">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- ===== 1. PHOTO with badge and "5+ Years" box on top ===== -->
            <Grid HeightRequest="260" BackgroundColor="{DynamicResource Navy}">
                <Image Source="andiswa_branding.jpg" Aspect="AspectFill" />

                <Border BackgroundColor="{DynamicResource Navy}" StrokeThickness="0" StrokeShape="RoundRectangle 18"
                        Padding="14,7" HorizontalOptions="Start" VerticalOptions="Start" Margin="16">
                    <Label Text="★  Award-Winning Studio" FontSize="12" FontAttributes="Bold" TextColor="White" />
                </Border>

                <Border BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                        Padding="16,10" HorizontalOptions="End" VerticalOptions="End" Margin="16">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="5+" FontSize="30" FontAttributes="Bold" TextColor="{DynamicResource Navy}" />
                        <Label Text="Years of Design Excellence" FontSize="12" TextColor="{DynamicResource Muted}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- ===== 2. WHO WE ARE ===== -->
            <VerticalStackLayout Padding="24,44,24,16" Spacing="20">
                <controls:SectionHeader Tag="WHO WE ARE" TitleMain="A Creative Studio Built on" TitleAccent="Bold Ideas" />
                <Label Text="{Binding AboutText1}" FontSize="17" LineHeight="1.5" TextColor="{DynamicResource Ink}" />
                <Label Text="{Binding AboutText2}" FontSize="15" LineHeight="1.45" TextColor="{DynamicResource Muted}" />
            </VerticalStackLayout>

            <!-- ===== 3. MISSION AND VISION ===== -->
            <VerticalStackLayout Padding="24,8,24,16" Spacing="14">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="▲" FontSize="10" TextColor="{DynamicResource Steel}" VerticalOptions="Center" />
                            <Label Text="OUR MISSION" FontSize="12" CharacterSpacing="3" FontAttributes="Bold"
                                   TextColor="{DynamicResource Steel}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Text="{x:Static models:SiteContent.Mission}" FontSize="18" FontAttributes="Bold"
                               LineHeight="1.35" TextColor="{DynamicResource Navy}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="▲" FontSize="10" TextColor="{DynamicResource Steel}" VerticalOptions="Center" />
                            <Label Text="OUR VISION" FontSize="12" CharacterSpacing="3" FontAttributes="Bold"
                                   TextColor="{DynamicResource Steel}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Text="{x:Static models:SiteContent.Vision}" FontSize="18" FontAttributes="Bold"
                               LineHeight="1.35" TextColor="{DynamicResource Navy}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ===== 4. OUR VALUES ===== -->
            <FlexLayout Wrap="Wrap" Direction="Row" Padding="24,10,24,24"
                        BindableLayout.ItemsSource="{x:Static models:SiteContent.Values}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 20" Padding="16,9" Margin="0,0,8,8">
                            <Label Text="{Binding .}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource Navy}" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- ===== 5. MEET THE TEAM ===== -->
            <VerticalStackLayout Padding="24,36,24,48" Spacing="16" BackgroundColor="{DynamicResource Mist}">
                <controls:SectionHeader Tag="THE TEAM" TitleMain="The people behind" TitleAccent="every brand we build." />
                <Button Text="Meet the Team  →" Style="{StaticResource PrimaryButton}" Clicked="OnTeamClicked" />
            </VerticalStackLayout>

            <!-- ===== 6. NEWSLETTER AND FOOTER ===== -->
            <controls:NewsletterBox />
            <controls:SiteFooter />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>