<?xml version="1.0" encoding="utf-8" ?>
<!--
  ClientDashboardPage.xaml  -  the CLIENT PORTAL dashboard (same as the website's client portal).
  It shows:  a navy top bar with "Log out"
             Welcome, <client name>
             "Your quote requests"  (service, message, status)
             "Your projects"        (appears once a quote is accepted and the admin creates the project)
  The data comes from the API: GET /api/client/dashboard.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AndiswaConsultationApp.Controls"
             x:Class="AndiswaConsultationApp.Pages.ClientDashboardPage"
             BackgroundColor="{DynamicResource PageBg}"
             ControlTemplate="{StaticResource TabPage}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- ===== 1. NAVY TOP BAR (like the website's portal header) ===== -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="20,44,20,16"
              BackgroundColor="{DynamicResource NavySoft}">
            <Label Text="Andiswa Business Consultation — Client Portal"
                   FontSize="14" FontAttributes="Bold" TextColor="White"
                   VerticalOptions="Center" LineBreakMode="TailTruncation" />
            <Label Grid.Column="1" Text="Log out" FontSize="14" TextColor="White"
                   VerticalOptions="Center" Padding="12,6,0,6">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLogoutTapped" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <!-- ===== 2. THE CONTENT (pull down to refresh) ===== -->
        <RefreshView Grid.Row="1" x:Name="Refresh" RefreshColor="{DynamicResource Navy}" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Padding="20,24,20,32" Spacing="18">

                    <Label x:Name="WelcomeLabel" Text="Welcome" FontSize="26" FontAttributes="Bold"
                           TextColor="{DynamicResource Ink}" />

                    <!-- Error / offline message with "Try again" -->
                    <!-- The negative margin cancels the box's own 24px margin so it lines up with the cards -->
                    <controls:ErrorBox x:Name="ErrorBox" Margin="-24,-16" />

                    <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False"
                                       Color="{DynamicResource Navy}" />

                    <!-- ===== 2a. YOUR QUOTE REQUESTS ===== -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Your quote requests" FontSize="20" FontAttributes="Bold"
                                   TextColor="{DynamicResource Ink}" Margin="0,0,0,16" />

                            <!-- Shown when there are no quote requests -->
                            <Label x:Name="NoQuotesLabel" IsVisible="False" FontSize="14"
                                   TextColor="{DynamicResource Muted}"
                                   Text="You have not sent any quote requests yet. Use the Contact tab to ask for a quote." />

                            <!-- One block per quote request -->
                            <VerticalStackLayout x:Name="QuotesList" Spacing="16">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="10">
                                            <Label Text="{Binding Service}" FontSize="15" FontAttributes="Bold"
                                                   TextColor="{DynamicResource Ink}" />
                                            <Label Text="{Binding Message}" FontSize="14" LineHeight="1.4"
                                                   TextColor="{DynamicResource Ink}" />
                                            <Label FontSize="14" TextColor="{DynamicResource Muted}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Status: " />
                                                        <Span Text="{Binding Status}" FontAttributes="Bold" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <BoxView HeightRequest="1" Color="{DynamicResource Line}" Margin="0,4,0,0" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ===== 2b. YOUR PROJECTS ===== -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Your projects" FontSize="20" FontAttributes="Bold"
                                   TextColor="{DynamicResource Ink}" Margin="0,0,0,16" />

                            <!-- Shown when there are no projects (same sentence as the website) -->
                            <Label x:Name="NoProjectsLabel" IsVisible="False" FontSize="14"
                                   TextColor="{DynamicResource Muted}"
                                   Text="A project will appear here once your quote has been accepted and the project has been created." />

                            <VerticalStackLayout x:Name="ProjectsList" Spacing="16">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="8">
                                            <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold"
                                                   TextColor="{DynamicResource Ink}" />
                                            <Label FontSize="14" TextColor="{DynamicResource Muted}"
                                                   IsVisible="{Binding HasStatus}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Status: " />
                                                        <Span Text="{Binding Status}" FontAttributes="Bold" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <BoxView HeightRequest="1" Color="{DynamicResource Line}" Margin="0,4,0,0" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
