<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AndiswaConsultationApp.Controls"
             xmlns:models="clr-namespace:AndiswaConsultationApp.Models"
             x:Class="AndiswaConsultationApp.Pages.TeamPage"
             Title="Team"
             BackgroundColor="{DynamicResource PageBg}"
             Shell.NavBarIsVisible="True">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <VerticalStackLayout Padding="24,40,24,28" Spacing="14">
                <controls:SectionHeader Tag="MEET THE TEAM" TitleMain="The people behind" TitleAccent="every brand we build." />
                <Label Text="Strategy, design and delivery under one roof — here's who you'll be working with."
                       FontSize="16" LineHeight="1.45" TextColor="{DynamicResource Muted}" />
            </VerticalStackLayout>

            <!-- One card for every team member -->
            <VerticalStackLayout Padding="24,0,24,48" Spacing="14"
                                 BindableLayout.ItemsSource="{x:Static models:SiteContent.Team}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="24">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Border BackgroundColor="{DynamicResource Navy}" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 42" WidthRequest="84" HeightRequest="84"
                                        HorizontalOptions="Center">
                                    <Label Text="{Binding Initials}" FontSize="28" FontAttributes="Bold" TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="{Binding Name}" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource Navy}"
                                       HorizontalTextAlignment="Center" Margin="0,10,0,0" />
                                <Label Text="{Binding Role}" FontSize="14" TextColor="{DynamicResource Steel}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{Binding Email}" FontSize="14" TextColor="{DynamicResource Muted}"
                                       HorizontalTextAlignment="Center" TextDecorations="Underline" Margin="0,6,0,0">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnEmailTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <controls:SiteFooter />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>