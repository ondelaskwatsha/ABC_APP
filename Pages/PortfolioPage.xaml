<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AndiswaConsultationApp.Controls"
             xmlns:models="clr-namespace:AndiswaConsultationApp.Models"
             x:Class="AndiswaConsultationApp.Pages.PortfolioPage"
             BackgroundColor="{DynamicResource PageBg}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- ===== 1. TITLE ===== -->
            <VerticalStackLayout Padding="24,56,24,12" Spacing="14">
                <controls:SectionHeader Tag="OUR CREATIVE PORTFOLIO" TitleMain="Selected Projects" />
                <Label Text="Explore our collection of branding, flyers, posters and social media designs created for businesses across different industries."
                       FontSize="16" LineHeight="1.45" TextColor="{DynamicResource Muted}" />
            </VerticalStackLayout>

            <!-- ===== 2. SEARCH ===== -->
            <VerticalStackLayout Padding="24,8,24,0" Spacing="10">
                <Border Style="{StaticResource FieldBorder}">
                    <Entry x:Name="SearchEntry" Placeholder="Search projects..." Style="{StaticResource FieldEntry}"
                           TextChanged="OnSearchTextChanged" />
                </Border>
                <Label x:Name="CountLabel" FontSize="13" TextColor="{DynamicResource Muted}" />
            </VerticalStackLayout>

            <!-- ===== 3. FILTER BUTTONS (created in PortfolioPage.xaml.cs) ===== -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,10,0,0">
                <HorizontalStackLayout x:Name="FilterLayout" Spacing="10" Padding="24,0" />
            </ScrollView>

            <!-- ===== 4. FEATURED PROJECT ===== -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="24,26,24,0"
                    BindingContext="{x:Static models:SiteContent.FeaturedProject}">
                <VerticalStackLayout Spacing="0">
                    <Image Source="{Binding Image}" Aspect="AspectFit" HeightRequest="200"
                           BackgroundColor="{DynamicResource Mist}" />
                    <VerticalStackLayout Padding="20" Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="▲" FontSize="10" TextColor="{DynamicResource Steel}" VerticalOptions="Center" />
                            <Label Text="FEATURED PROJECT" FontSize="12" CharacterSpacing="3" FontAttributes="Bold"
                                   TextColor="{DynamicResource Steel}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding Title}" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource Navy}" />
                        <Label Text="{Binding Description}" FontSize="15" LineHeight="1.45" TextColor="{DynamicResource Muted}" />
                        <VerticalStackLayout Spacing="4" Margin="0,4,0,0"
                                             BindableLayout.ItemsSource="{Binding Highlights}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding ., StringFormat='✓  {0}'}" FontSize="14"
                                           TextColor="{DynamicResource Steel}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Button Text="View Project" Style="{StaticResource PrimaryButton}"
                                Margin="0,10,0,0" Clicked="OnFeaturedClicked" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ===== 5. THE GALLERY (created in PortfolioPage.xaml.cs, BuildGallery) ===== -->
            <Grid x:Name="Gallery" ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="12" Padding="24,26,24,0" />

            <Label x:Name="EmptyLabel" Text="No projects match your search." IsVisible="False"
                   FontSize="15" TextColor="{DynamicResource Muted}" HorizontalTextAlignment="Center"
                   Margin="24,30,24,0" />

            <BoxView HeightRequest="48" Color="Transparent" />

            <!-- ===== 6. FOOTER ===== -->
            <controls:SiteFooter x:Name="Footer" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>