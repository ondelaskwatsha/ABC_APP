<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AndiswaConsultationApp.Controls"
             x:Class="AndiswaConsultationApp.Pages.ContactPage"
             BackgroundColor="{DynamicResource PageBg}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <VerticalStackLayout Padding="24,56,24,40" Spacing="8">

                <!-- ===== 1. TITLE ===== -->
                <controls:SectionHeader Tag="GET IN TOUCH" TitleMain="Let's build something you're proud to"
                                        TitleAccent="put your name on." />

                <Label Text="Tell us about the project and we'll come back to you within one business day with next steps."
                       FontSize="16" LineHeight="1.45" TextColor="{DynamicResource Muted}" Margin="0,14,0,10" />

                <!-- ===== 2. MESSAGE BOX ===== -->
                <controls:ErrorBox x:Name="ErrorBox" Margin="-24,0" />

                <!-- ===== 3. THE FORM ===== -->
                <Label Text="First Name" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBorder}">
                    <Entry x:Name="FirstNameEntry" Placeholder="Ayanda" Style="{StaticResource FieldEntry}" />
                </Border>

                <Label Text="Last Name" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBorder}">
                    <Entry x:Name="LastNameEntry" Placeholder="Zulu" Style="{StaticResource FieldEntry}" />
                </Border>

                <Label Text="Email Address" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBorder}">
                    <Entry x:Name="EmailEntry" Placeholder="you@company.co.za" Keyboard="Email"
                           Style="{StaticResource FieldEntry}" />
                </Border>

                <Label Text="Phone Number (optional)" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBorder}">
                    <Entry x:Name="PhoneEntry" Placeholder="+27 123 456 789" Keyboard="Telephone"
                           Style="{StaticResource FieldEntry}" />
                </Border>

                <Label Text="Service Required" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBorder}">
                    <Picker x:Name="ServicePicker" Title="Select a service" TitleColor="{DynamicResource Soft}"
                            TextColor="{DynamicResource Ink}" FontSize="16" HeightRequest="52"
                            BackgroundColor="Transparent" />
                </Border>

                <Label Text="Tell us about the project" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBorder}" Padding="10,6">
                    <Editor x:Name="MessageEditor" Placeholder="What are you looking to grow?"
                            PlaceholderColor="{DynamicResource Soft}" TextColor="{DynamicResource Ink}" FontSize="16"
                            BackgroundColor="Transparent" HeightRequest="150" MaxLength="4000" />
                </Border>

                <Button x:Name="SendButton" Text="Send Message  →" Style="{StaticResource PrimaryButton}"
                        Margin="0,18,0,0" Clicked="OnSendClicked" />

                <Label Text="We typically reply within one business day." FontSize="13" TextColor="{DynamicResource Muted}"
                       HorizontalOptions="Center" />

                <ActivityIndicator x:Name="Busy" Color="{DynamicResource Navy}" IsRunning="False" IsVisible="False" />

                <!-- ===== 4. CONTACT DETAILS ===== -->
                <Border BackgroundColor="{DynamicResource Mist}" Stroke="{DynamicResource Line}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 18" Padding="22" Margin="0,24,0,0">
                    <VerticalStackLayout Spacing="20">

                        <VerticalStackLayout Spacing="3">
                            <Label Text="EMAIL" FontSize="12" CharacterSpacing="1" FontAttributes="Bold" TextColor="{DynamicResource Steel}" />
                            <Label Text="{Binding Email}" FontSize="16" TextColor="{DynamicResource Ink}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEmailTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="3">
                            <Label Text="PHONE" FontSize="12" CharacterSpacing="1" FontAttributes="Bold" TextColor="{DynamicResource Steel}" />
                            <Label Text="{Binding Phone}" FontSize="16" TextColor="{DynamicResource Ink}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPhoneTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="3">
                            <Label Text="LOCATION" FontSize="12" CharacterSpacing="1" FontAttributes="Bold" TextColor="{DynamicResource Steel}" />
                            <Label Text="{Binding Address}" FontSize="16" TextColor="{DynamicResource Ink}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="3">
                            <Label Text="BUSINESS HOURS" FontSize="12" CharacterSpacing="1" FontAttributes="Bold" TextColor="{DynamicResource Steel}" />
                            <Label Text="{Binding Hours}" FontSize="16" TextColor="{DynamicResource Ink}" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- ===== 5. OWNER CARD ===== -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <HorizontalStackLayout Spacing="18">
                        <Border BackgroundColor="{DynamicResource Navy}" StrokeThickness="0" StrokeShape="RoundRectangle 32"
                                WidthRequest="64" HeightRequest="64">
                            <Label Text="{Binding OwnerInitials}" FontSize="22" FontAttributes="Bold"
                                   TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding OwnerName}" FontSize="19" FontAttributes="Bold" TextColor="{DynamicResource Navy}" />
                            <Label Text="{Binding OwnerTitle}" FontSize="15" TextColor="{DynamicResource Muted}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

                <!-- ===== 6. QUICK ANSWERS (created in ContactPage.xaml.cs, BuildFaq) ===== -->
                <VerticalStackLayout Margin="0,34,0,0" Spacing="12">
                    <controls:SectionHeader Tag="QUICK ANSWERS" TitleMain="Questions we get a lot" />
                    <VerticalStackLayout x:Name="FaqLayout" Spacing="10" Margin="0,6,0,0" />
                </VerticalStackLayout>

            </VerticalStackLayout>

            <!-- ===== 7. FOOTER ===== -->
            <controls:SiteFooter x:Name="Footer" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>