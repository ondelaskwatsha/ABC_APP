<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AndiswaConsultationApp.Controls"
             xmlns:models="clr-namespace:AndiswaConsultationApp.Models"
             x:Class="AndiswaConsultationApp.Pages.ServicesPage"
             BackgroundColor="{DynamicResource PageBg}"
             ControlTemplate="{StaticResource TabPage}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- ===== 1. TITLE ===== -->
            <VerticalStackLayout Padding="24,56,24,24" Spacing="12">
                <controls:SectionHeader Tag="WHAT WE CREATE" TitleMain="Design Services That" TitleAccent="Move Brands Forward" />
                <Label Text="Tap a service to ask for a quote."
                       FontSize="14" TextColor="{DynamicResource Muted}" Margin="0,4,0,0" />
            </VerticalStackLayout>

            <!-- ===== 2. THE TEN SERVICES ===== -->
            <VerticalStackLayout Padding="24,0,24,48" Spacing="12"
                                 BindableLayout.ItemsSource="{x:Static models:SiteContent.Services}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnServiceTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="56,*" ColumnSpacing="14">
                                <Border BackgroundColor="{DynamicResource Mist}" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 28" WidthRequest="56" HeightRequest="56"
                                        VerticalOptions="Start">
                                    <Label Text="{Binding Icon}" FontSize="26"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                    <Label Text="{Binding Title}" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource Navy}" />
                                    <Label Text="{Binding Description}" FontSize="14" LineHeight="1.4" TextColor="{DynamicResource Muted}" />
                                    <Label Text="Request this service  →" FontSize="13" FontAttributes="Bold"
                                           TextColor="{DynamicResource Steel}" Margin="0,6,0,0" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- ===== 3. WHY CLIENTS CHOOSE US (navy section) ===== -->
            <VerticalStackLayout Padding="24,52,24,52" Spacing="16" BackgroundColor="{DynamicResource Navy}">
                <controls:SectionHeader Tag="WHY CHOOSE US" TitleMain="Why Clients Choose"
                                        TitleAccent="Andiswa Business Consultation"
                                        TagColor="{DynamicResource SteelLight}"
                                        MainColor="{DynamicResource Cream}"
                                        AccentColor="{DynamicResource SteelLight}" />

                <VerticalStackLayout Spacing="12" Margin="0,12,0,0"
                                     BindableLayout.ItemsSource="{x:Static models:SiteContent.Reasons}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{DynamicResource NavySoft}" Stroke="#33506E" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14" Padding="18">
                                <VerticalStackLayout Spacing="6">
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="▲" FontSize="10" TextColor="{DynamicResource SteelLight}" VerticalOptions="Center" />
                                        <Label Text="{Binding Title}" FontSize="17" FontAttributes="Bold" TextColor="White"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Description}" FontSize="14" LineHeight="1.45"
                                           TextColor="{DynamicResource OnDarkMuted}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- ===== 4. NEWSLETTER ===== -->
            <controls:NewsletterBox />

            <!-- ===== 5. FOOTER ===== -->
            <controls:SiteFooter x:Name="Footer" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>