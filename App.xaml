<?xml version="1.0" encoding="UTF-8" ?>
<!--
  App.xaml  -  the THEME of the whole app (colours and styles).
  Colours are used with {DynamicResource Name} so they change live with dark mode.
  The values here are the LIGHT theme; ThemeService.cs swaps them for the dark values.
-->
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AndiswaConsultationApp.Controls"
             x:Class="AndiswaConsultationApp.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ============ COLOURS (light theme values) ============ -->
            <Color x:Key="Navy">#1B2A41</Color>
            <Color x:Key="NavyDeep">#101B2B</Color>
            <Color x:Key="NavySoft">#24384F</Color>
            <Color x:Key="Steel">#3E6690</Color>
            <Color x:Key="SteelLight">#5B8DB8</Color>
            <Color x:Key="Cream">#F7F8FA</Color>
            <Color x:Key="Mist">#EEF1F4</Color>
            <Color x:Key="Ink">#232830</Color>
            <Color x:Key="Muted">#5B6472</Color>
            <Color x:Key="Soft">#8891A0</Color>
            <Color x:Key="Line">#DDE2E8</Color>
            <Color x:Key="OnDarkMuted">#B9C4D2</Color>
            <Color x:Key="PageBg">#F7F8FA</Color>
            <Color x:Key="Surface">#FFFFFF</Color>

            <!-- The font of the whole app. Empty = the phone's normal font. Set by ThemeService. -->
            <x:String x:Key="AppFontFamily"></x:String>

            <!-- Apply the chosen font to every Label, Button, Entry, Editor and Picker -->
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            </Style>
            <Style TargetType="Entry">
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            </Style>
            <Style TargetType="Editor">
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            </Style>
            <Style TargetType="Picker">
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            </Style>

            <!-- Main button: navy pill with white text (on light backgrounds) -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource Navy}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="CornerRadius" Value="26" />
                <Setter Property="HeightRequest" Value="52" />
            </Style>

            <!-- Secondary button: navy outline -->
            <Style x:Key="OutlineButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{DynamicResource Navy}" />
                <Setter Property="BorderColor" Value="{DynamicResource Navy}" />
                <Setter Property="BorderWidth" Value="1.5" />
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="CornerRadius" Value="26" />
                <Setter Property="HeightRequest" Value="52" />
            </Style>

            <!-- Main button on a NAVY background: light pill -->
            <Style x:Key="LightButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource Cream}" />
                <Setter Property="TextColor" Value="{DynamicResource NavyDeep}" />
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="CornerRadius" Value="26" />
                <Setter Property="HeightRequest" Value="52" />
            </Style>

            <!-- Secondary button on a NAVY background: light outline -->
            <Style x:Key="LightOutlineButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{DynamicResource Cream}" />
                <Setter Property="BorderColor" Value="#8FA3BA" />
                <Setter Property="BorderWidth" Value="1.5" />
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="CornerRadius" Value="26" />
                <Setter Property="HeightRequest" Value="52" />
            </Style>

            <!-- A card with a thin outline and rounded corners -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
                <Setter Property="Stroke" Value="{DynamicResource Line}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <!-- Rounded outline around each form field -->
            <Style x:Key="FieldBorder" TargetType="Border">
                <Setter Property="Stroke" Value="{DynamicResource Line}" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
            </Style>

            <!-- The text box inside the outline -->
            <Style x:Key="FieldEntry" TargetType="Entry">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
                <Setter Property="TextColor" Value="{DynamicResource Ink}" />
                <Setter Property="PlaceholderColor" Value="{DynamicResource Soft}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="HeightRequest" Value="52" />
            </Style>

            <!-- The small title above each field -->
            <Style x:Key="FieldLabel" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
                <Setter Property="TextColor" Value="{DynamicResource Ink}" />
                <Setter Property="Margin" Value="0,14,0,6" />
            </Style>

            <!-- ============ TAB PAGE TEMPLATE ============
                 Every tab page uses this with  ControlTemplate="{StaticResource TabPage}".
                 It puts the page's own content on top (ContentPresenter)
                 and the navigation bar at the bottom (BottomNavBar). -->
            <ControlTemplate x:Key="TabPage">
                <Grid RowDefinitions="*,Auto" RowSpacing="0">
                    <ContentPresenter Grid.Row="0" />
                    <controls:BottomNavBar Grid.Row="1" />
                </Grid>
            </ControlTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>