<?xml version="1.0" encoding="UTF-8" ?>
<!--
  SectionHeader.xaml  -  a reusable page title.

  It draws:   a short blue line + a small capital label   (for example  ___ WHO WE ARE)
              a big dark title
              a big light blue second line                 (for example  Bold Ideas)

  Use it on any page like this:
    <controls:SectionHeader Tag="OUR WORK" TitleMain="Projects That" TitleAccent="Make an Impact" />

  {Binding Tag} means "show the value of the Tag property here".
  BindingContext="{x:Reference root}" tells the bindings to read the properties of THIS control.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AndiswaConsultationApp.Controls.SectionHeader"
             x:Name="root">

    <VerticalStackLayout Spacing="14" BindingContext="{x:Reference root}">

        <!-- Line + small label, side by side -->
        <HorizontalStackLayout Spacing="12">
            <BoxView WidthRequest="30" HeightRequest="2" Color="{StaticResource Sky}" VerticalOptions="Center" />
            <Label Text="{Binding Tag}" FontSize="12" CharacterSpacing="3" TextColor="{StaticResource Primary}" />
        </HorizontalStackLayout>

        <!-- Big title: first part dark, second part light blue (hidden when empty) -->
        <VerticalStackLayout Spacing="0">
            <Label Text="{Binding TitleMain}" FontSize="32" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
            <Label Text="{Binding TitleAccent}" FontSize="32" FontAttributes="Bold" TextColor="{StaticResource Sky}"
                   IsVisible="{Binding HasAccent}" />
        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentView>
