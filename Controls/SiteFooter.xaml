<?xml version="1.0" encoding="UTF-8" ?>
<!--
  SiteFooter.xaml  -  the website's footer, for the bottom of every page.

  It shows: the A|B logo and short text, the social media buttons, the contact details
  (tap the phone or email to call / write), and the copyright line.
  The text comes from SiteContent (Models/Models.cs), the same words as the website footer.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AndiswaConsultationApp.Models"
             x:Class="AndiswaConsultationApp.Controls.SiteFooter">
    
    <VerticalStackLayout BackgroundColor="{DynamicResource NavyDeep}" Padding="24,44,24,28" Spacing="20">

        <Label Text="A|B" FontSize="34" FontAttributes="Bold" TextColor="White" />

        <Label Text="{x:Static models:SiteContent.FooterBlurb}" FontSize="14" LineHeight="1.5" TextColor="#9AA8B9" />

        <!-- The round social buttons are created in SiteFooter.xaml.cs (BuildSocial) -->
        <HorizontalStackLayout x:Name="SocialLayout" Spacing="10" />

        <Label Text="Contact" FontSize="18" FontAttributes="Bold" TextColor="White" Margin="0,10,0,0" />

        <VerticalStackLayout Spacing="14">
            <Label Text="{x:Static models:SiteContent.Phone}" FontSize="14" TextColor="#D5DCE5">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPhoneTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label Text="{x:Static models:SiteContent.Email}" FontSize="14" TextColor="#D5DCE5">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnEmailTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label Text="{x:Static models:SiteContent.Address}" FontSize="14" TextColor="#D5DCE5" />
            <Label Text="{x:Static models:SiteContent.Hours}" FontSize="14" TextColor="#D5DCE5" />
        </VerticalStackLayout>

        <BoxView HeightRequest="1" Color="#2A3B52" Margin="0,10,0,0" />

        <VerticalStackLayout Spacing="4">
            <Label Text="{x:Static models:SiteContent.Copyright}" FontSize="12" TextColor="#7F8DA0" />
            <Label Text="{x:Static models:SiteContent.Crafted}" FontSize="12" TextColor="#7F8DA0" />
        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentView>
