<?xml version="1.0" encoding="UTF-8" ?>
<!--
  ErrorBox.xaml  -  a message box that pages show when something happens.

  Two looks (chosen in ErrorBox.xaml.cs):
    Show(...)      red box with a "Try again" button   = a real problem
    ShowInfo(...)  soft navy-grey box, no button        = just a note, for example "You're offline"

  IsVisible="False" means it is hidden until a page calls Show or ShowInfo.
  x:Name gives a part a name so the C# code can change it (Box, MessageLabel, RetryButton).
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AndiswaConsultationApp.Controls.ErrorBox"
             IsVisible="False">

    <Border x:Name="Box" BackgroundColor="#FFF4F4" Stroke="#E0B4B4" StrokeThickness="1"
            StrokeShape="RoundRectangle 12" Padding="16" Margin="24,16">
        <VerticalStackLayout Spacing="12">
            <Label x:Name="MessageLabel" TextColor="#8A1F1F" FontSize="14" />
            <!-- Clicked="OnRetryClicked" runs that method in ErrorBox.xaml.cs when the button is tapped -->
            <Button x:Name="RetryButton" Text="Try again" BackgroundColor="{StaticResource Navy}" TextColor="White"
                    CornerRadius="22" HeightRequest="44" Clicked="OnRetryClicked" />
        </VerticalStackLayout>
    </Border>
</ContentView>
