<?xml version="1.0" encoding="UTF-8" ?>
<!--
  ErrorBox.xaml  -  a message box pages show when something happens.
  Show(...) = red box with "Try again";  ShowInfo(...) = soft note, no button.
  The colours are set in ErrorBox.xaml.cs from the theme, so they work in dark mode too.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AndiswaConsultationApp.Controls.ErrorBox"
             IsVisible="False">

    <Border x:Name="Box" BackgroundColor="{DynamicResource ErrorBg}" Stroke="{DynamicResource ErrorLine}" StrokeThickness="1"
            StrokeShape="RoundRectangle 12" Padding="16" Margin="24,16">
        <VerticalStackLayout Spacing="12">
            <Label x:Name="MessageLabel" TextColor="{DynamicResource ErrorText}" FontSize="14" />
            <Button x:Name="RetryButton" Text="Try again" BackgroundColor="{DynamicResource Navy}" TextColor="White"
                    CornerRadius="22" HeightRequest="44" Clicked="OnRetryClicked" />
        </VerticalStackLayout>
    </Border>
</ContentView>