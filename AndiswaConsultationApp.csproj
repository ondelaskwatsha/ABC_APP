<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android always. "Windows Machine" is added automatically when you open this on Windows,
		     so you can run the app on the lab PC without an emulator. -->
		<TargetFrameworks>net8.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net8.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>AndiswaConsultationApp</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- .NET 8 MAUI is out of Microsoft support, and newer Visual Studio versions stop the build
		     with an "out of support" error. That is fine for a student project, so we switch that check off. -->
		<CheckEolWorkloads>false</CheckEolWorkloads>

		<ApplicationTitle>Andiswa Consultation</ApplicationTitle>
		<ApplicationId>com.andiswa.consultationapp</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Run on Windows without packaging (no developer mode needed) -->
		<WindowsPackageType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App icon and start-up screen (navy, same as the website) -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1B2A41" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1B2A41" BaseSize="128,128" />

		<!-- Images (the tab bar icons live here) -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Files packed inside the app, for example seed.json (the information shown when there is no internet) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
	</ItemGroup>

</Project>
